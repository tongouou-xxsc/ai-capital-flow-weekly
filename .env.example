# Required by SEC fair-access policy. Use your real email or company contact.
SEC_USER_AGENT=AI Capital Flow Weekly contact@example.com

# Optional search settings. If unset, the agent uses DuckDuckGo HTML search.
# BRAVE_SEARCH_API_KEY=
# SERPAPI_API_KEY=

# Report behavior.
REPORT_TIMEZONE=America/New_York
REPORT_LOOKBACK_DAYS=7
REPORT_OUTPUT_DIR=reports

# ARK ETFs to include.
ARK_FUNDS=ARKK,ARKQ,ARKW,ARKG,ARKF,ARKX
